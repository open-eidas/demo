# Hébergement o2switch : HTTPS, domaine canonique et en-têtes de base.
Options -Indexes
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^demo\.open-eidas\.eu$ [NC]
RewriteRule ^ https://demo.open-eidas.eu%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  # Le service worker doit être relu à chaque visite pour que les mises à jour arrivent.
  <FilesMatch "^(sw\.js|index\.html|manifest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .json
</IfModule>
